# ── Convoca backend environment ──────────────────────────────────────────────

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# HTTP port the API listens on.
PORT=8000

# Public URL of the Next.js frontend. Used to build self-registration links and
# email call-to-action buttons. In production: https://convoca.space
APP_BASE_URL=http://localhost:3000

# Platform's central email sender: a Gmail / Google Workspace account + its
# App Password (spaces are stripped automatically). This is the default sender
# for ALL outgoing mail. An org may still override it with its own Gmail at
# registration; leave those fields blank to use this account.
APP_GMAIL_USER=platform@yourdomain.com
APP_GMAIL_PASS=your16charapppassword

# Path to the Firebase service-account JSON (Cloud Datastore User / Editor role).
SERVICE_ACCOUNT_PATH=./service-account.json

# Firestore database id. Leave as the default unless you created a named db.
FIRESTORE_DATABASE=(default)

# OTP / session lifetimes (minutes / days).
OTP_TTL_MINUTES=10
SESSION_TTL_DAYS=7

# Note: CORS is intentionally open to all origins/methods (Bearer-token auth,
# no cookies), so there is no CORS allowlist to configure.
