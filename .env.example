# ── Convoca backend environment ──────────────────────────────────────────────

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# HTTP port the API listens on.
PORT=8000

# Public URL of the Next.js frontend. Used to build self-registration links and
# email call-to-action buttons.
APP_BASE_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins for the browser dashboard.
CORS_ORIGINS=http://localhost:3000

# Optional: path to the Deno KV database file. Defaults to the runtime default
# (a persistent local KV) when omitted. On Deno Deploy this is ignored.
# KV_PATH=./data/convoca.db

# OTP / session lifetimes (minutes / days).
OTP_TTL_MINUTES=10
SESSION_TTL_DAYS=7
